# Copy to .env.local for local development, or set these in Vercel → Project Settings → Environment Variables.

# Backend origin. Leave empty to call the same origin (Vercel rewrite to the backend).
VITE_API_BASE_URL=http://localhost:8080

# Optional. Defaults to ${VITE_API_BASE_URL}/actuator.
VITE_ACTUATOR_BASE_URL=

# true = bundled fixtures captured from the real backend; false = live backend.
# When unset, fixtures are used only if VITE_API_BASE_URL is empty.
VITE_USE_MOCK_DATA=false

# Process opened on first visit.
VITE_DEFAULT_PROCESS_KEY=order-to-cash

# Analytics are computed on demand from every event of a process; allow time for large processes.
VITE_REQUEST_TIMEOUT_MS=30000
